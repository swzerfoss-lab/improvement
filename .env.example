DATABASE_URL=postgres://app:app@localhost:5432/sponsor

# Any long random string. Encrypts wearable access tokens at rest.
TOKEN_ENCRYPTION_KEY=change-me

# "true" enables the simulated wearable and its skip-ahead clock.
ENABLE_SIMULATOR=true

# Comma-separated emails allowed to open /admin/reviews.
ADMIN_EMAILS=

# Public base URL of this app, used for the Google OAuth redirect.
APP_URL=http://localhost:3000

# Google Health API (Fitbit and Pixel Watch). Leave empty to hide the option.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
